# Copy to .env. Never commit .env or real credentials.
# Choose: demo | free | azure
APP_MODE=demo
DATABRICKS_FREE_HOST=https://your-free-edition-workspace-url
DATABRICKS_FREE_TOKEN=
AZURE_DATABRICKS_HOST=https://your-azure-databricks-workspace.azuredatabricks.net
AZURE_DATABRICKS_TOKEN=
DATABRICKS_HOST=
DATABRICKS_TOKEN=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_DATA_FACTORY_NAME=
